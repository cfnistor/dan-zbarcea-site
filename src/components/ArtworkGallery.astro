---
type Lang = "fr" | "en";

type FilterOption = {
    label: {
        fr: string;
        en: string;
    };
    value: string;
};

type FilterConfig = {
    key: string;
    label: {
        fr: string;
        en: string;
    };
    options: FilterOption[];
};

type Artwork = {
    id: string;
    title: {
        fr: string;
        en: string;
    };
    image: string;
    meta: {
        fr: string[];
        en: string[];
    };
    filters: Record<string, string>;
};

const {
    lang = "fr",
    artworks = [],
    filters = [],
} = Astro.props as {
    lang: Lang;
    artworks: Artwork[];
    filters: FilterConfig[];
};

const labels = {
    fr: {
        all: "Tous",
        reset: "Réinitialiser",
    },
    en: {
        all: "All",
        reset: "Reset",
    },
};
---

<section class="artwork-gallery">
    <div class="filters">
        {
            filters.map((filter) => (
                    <select data-filter={filter.key}>
                        <option value="">
                            {filter.label[lang]}: {labels[lang].all}
                        </option>

                        {filter.options.map((option) => (
                                <option value={option.value}>
                                    {option.label[lang]}
                                </option>
                        ))}
                    </select>
            ))
        }

        <button type="button" class="reset-filters">
            {labels[lang].reset}
        </button>
    </div>

    <div class="gallery">
        {
            artworks.map((artwork) => (
                    <article
                            class="card"
                            data-filters={JSON.stringify({
                                series: artwork.series,
                                technique: artwork.techniqueKey,
                                year: String(artwork.year),
                                format: artwork.format,
                                location: artwork.location,
                                palette: artwork.palette,
                            })}
                    >
                        <button
                                class="image-button"
                                type="button"
                                data-lightbox-image={artwork.image}
                                data-lightbox-title={artwork.title[lang]}
                                data-lightbox-meta={`${artwork.technique[lang]} · ${artwork.series} · ${artwork.year}`}
                        >
                            <img src={artwork.image} alt={artwork.title[lang]} />
                        </button>

                        <div class="card-content">
                            <h3>{artwork.title[lang]}</h3>

                            <div class="artwork-meta">
                                <span>{artwork.technique[lang]}</span>
                                <span>{artwork.series}</span>
                                <span>{artwork.format}</span>
                                <span>{artwork.location}</span>
                                <span>{artwork.palette}</span>
                                <span>{artwork.year}</span>
                            </div>
                        </div>
                    </article>
            ))
        }
    </div>
</section>

<div class="lightbox" hidden>
    <div class="lightbox-frame">
        <button class="lightbox-close" type="button" aria-label="Close">×</button>

        <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous image">‹</button>

        <img class="lightbox-image" src="" alt="" />

        <button class="lightbox-nav lightbox-next" type="button" aria-label="Next image">›</button>

        <div class="lightbox-caption">
            <h3 class="lightbox-title"></h3>
            <p class="lightbox-meta"></p>
        </div>
    </div>
</div>

<script>
    const filters = document.querySelectorAll("[data-filter]");
    const cards = document.querySelectorAll(".card");
    const resetButton = document.querySelector(".reset-filters");

    const lightbox = document.querySelector(".lightbox");
    const lightboxImage = document.querySelector(".lightbox-image");
    const lightboxClose = document.querySelector(".lightbox-close");
    const imageButtons = document.querySelectorAll("[data-lightbox-image]");

    const lightboxTitle = document.querySelector(".lightbox-title");
    const lightboxMeta = document.querySelector(".lightbox-meta");
    const lightboxPrev = document.querySelector(".lightbox-prev");
    const lightboxNext = document.querySelector(".lightbox-next");

    let currentLightboxIndex = 0;

    function applyFilters() {
        const activeFilters = /** @type {Record<string, string>} */ ({});

        filters.forEach((filter) => {
            if (!(filter instanceof HTMLSelectElement)) return;

            const key = filter.dataset.filter;
            const value = filter.value;

            if (key && value) {
                activeFilters[key] = value;
            }
        });

        cards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return;

            const cardFilters = JSON.parse(card.dataset.filters || "{}");

            const isVisible = Object.entries(activeFilters).every(([key, value]) => {
                return cardFilters[key] === value;
            });

            card.style.display = isVisible ? "block" : "none";
        });
    }

    filters.forEach((filter) => {
        filter.addEventListener("change", applyFilters);
    });

    resetButton?.addEventListener("click", () => {
        filters.forEach((filter) => {
            if (filter instanceof HTMLSelectElement) {
                filter.value = "";
            }
        });

        applyFilters();
    });

    function getVisibleImageButtons() {
        return Array.from(imageButtons).filter((button) => {
            if (!(button instanceof HTMLElement)) return false;

            const card = button.closest(".card");

            if (!(card instanceof HTMLElement)) return false;

            return card.style.display !== "none";
        });
    }

    function openLightbox(button) {
        if (!(button instanceof HTMLElement)) return;
        if (!(lightbox instanceof HTMLElement)) return;
        if (!(lightboxImage instanceof HTMLImageElement)) return;

        lightboxImage.src = button.dataset.lightboxImage || "";
        lightboxImage.alt = button.dataset.lightboxTitle || "";

        if (lightboxTitle instanceof HTMLElement) {
            lightboxTitle.textContent = button.dataset.lightboxTitle || "";
        }

        if (lightboxMeta instanceof HTMLElement) {
            lightboxMeta.textContent = button.dataset.lightboxMeta || "";
        }

        lightbox.hidden = false;
        document.body.classList.add("lightbox-open");
    }

    function showLightboxImage(direction) {
        const visibleButtons = getVisibleImageButtons();

        if (visibleButtons.length === 0) return;

        currentLightboxIndex =
            (currentLightboxIndex + direction + visibleButtons.length) %
            visibleButtons.length;

        openLightbox(visibleButtons[currentLightboxIndex]);
    }

    imageButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const visibleButtons = getVisibleImageButtons();

            currentLightboxIndex = visibleButtons.indexOf(button);

            openLightbox(button);
        });
    });

    lightboxPrev?.addEventListener("click", () => {
        showLightboxImage(-1);
    });

    lightboxNext?.addEventListener("click", () => {
        showLightboxImage(1);
    });

    function closeLightbox() {
        if (!(lightbox instanceof HTMLElement)) return;
        if (!(lightboxImage instanceof HTMLImageElement)) return;

        lightbox.hidden = true;
        lightboxImage.src = "";
        document.body.classList.remove("lightbox-open");
    }

    lightboxClose?.addEventListener("click", closeLightbox);

    lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) {
            closeLightbox();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeLightbox();
        }

        if (event.key === "ArrowLeft") {
            showLightboxImage(-1);
        }

        if (event.key === "ArrowRight") {
            showLightboxImage(1);
        }
    });
</script>