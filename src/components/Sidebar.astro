---
const { lang = "fr", page = "home" } = Astro.props as {
    lang: "fr" | "en";
    page:
        | "home"
        | "graphic-art"
        | "painting"
        | "photography"
        | "process"
        | "biography"
        | "contact";
};

const menu = {
    fr: [
        { label: "Accueil", href: "/fr/", page: "home" },
        { label: "Art graphique", href: "/fr/art-graphique", page: "graphic-art" },
        { label: "Peinture", href: "/fr/peinture", page: "painting" },
        { label: "Photographie", href: "/fr/photographie", page: "photography" },
        { label: "Processus de création", href: "/fr/processus", page: "process" },
        { label: "Biographie", href: "/fr/biographie", page: "biography" },
        { label: "Contact", href: "/fr/contact", page: "contact" },
    ],
    en: [
        { label: "Home", href: "/en/", page: "home" },
        { label: "Graphic Art", href: "/en/graphic-art", page: "graphic-art" },
        { label: "Painting", href: "/en/painting", page: "painting" },
        { label: "Photography", href: "/en/photography", page: "photography" },
        { label: "Creative Process", href: "/en/process", page: "process" },
        { label: "Biography", href: "/en/biography", page: "biography" },
        { label: "Contact", href: "/en/contact", page: "contact" },
    ],
};

const languageSwitch = {
    home: { fr: "/fr/", en: "/en/" },
    "graphic-art": { fr: "/fr/art-graphique", en: "/en/graphic-art" },
    painting: { fr: "/fr/peinture", en: "/en/painting" },
    photography: { fr: "/fr/photographie", en: "/en/photography" },
    process: { fr: "/fr/processus", en: "/en/process" },
    biography: { fr: "/fr/biographie", en: "/en/biography" },
    contact: { fr: "/fr/contact", en: "/en/contact" },
};
---

<aside class="sidebar">
    <div class="mobile-header">
        <a class="mobile-brand" href={lang === "fr" ? "/fr/" : "/en/"}>
            Dan Zbarcea
        </a>

        <button
                class="menu-toggle"
                type="button"
                aria-label={lang === "fr" ? "Ouvrir le menu" : "Open menu"}
                aria-expanded="false"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>

    <div class="sidebar-panel">
        <h1>Dan<br />Zbarcea</h1>

        <nav>
            {menu[lang].map((item) => (
                    <a href={item.href} class={page === item.page ? "active" : ""}>
                        {item.label}
                    </a>
            ))}
        </nav>

        <div class="language-switcher">
            <a href={languageSwitch[page].fr}>FR</a>
            <span>|</span>
            <a href={languageSwitch[page].en}>EN</a>
        </div>

        <div class="infos">
            {lang === "fr" ? "Artiste visuel" : "Visual artist"}<br />
            Montréal, Québec
        </div>
    </div>
</aside>

<script>
    const menuButton = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    menuButton?.addEventListener("click", () => {
        const isOpen = sidebar?.classList.toggle("is-open") ?? false;
        menuButton.setAttribute("aria-expanded", String(isOpen));
    });
</script>