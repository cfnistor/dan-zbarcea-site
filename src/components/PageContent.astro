---
const {
    title,
    text,
    subtitle,
} = Astro.props;
---

<section class="page-content">
    <h2>{title}</h2>

    {subtitle && (
            <p class="page-subtitle">{subtitle}</p>
    )}

    {text ? (
            <div class="page-text" set:html={text} />
    ) : (
            <div class="page-text">
                <slot />
            </div>
    )}
</section>