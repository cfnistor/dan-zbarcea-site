---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PageContent from "../../components/PageContent.astro";

const biographySubtitle = {
    fr: "Artiste visuel, chercheur et enseignant",
    en: "Visual Artist, Researcher and Educator"
};
---

<BaseLayout title="Biography | Dan Zbarcea" lang="en-CA">

    <div class="page">

        <Sidebar lang="en" page="biography"/>

        <main class="content">

            <PageContent
                    title="Biography"
                    subtitle={biographySubtitle['en']}
                    text={`
                            <p>
                            As a practicing artist, art teacher and researcher, I use drawing, painting,
                            contemporary print media and digital photography to build a multidisciplinary
                            and multicultural artistic vision, as well as educational processes and perspectives.
                            I continually explore social, cultural, technological, ethical and ecological issues
                            that present intellectual challenges for the educational design community.
                            </p>
                            
                            <p>
                            My current research interests include visual art practice and communication across
                            classical art media, hypermedia, communication interfaces and media ethics.
                            I am particularly interested in the rhetorical and sometimes violent language of
                            hypermedia, as well as its complex effects on viewers as indirect participants in
                            the construction of knowledge.
                            </p>
                            
                            <p>
                            My work also examines educational strategies that encourage awareness,
                            critical thinking and reflective practices. Through artistic experimentation
                            and research, I seek to create meaningful connections between visual expression,
                            technology and learning.
                            </p>
                            
                            <p>
                            My professional background in law, graphic arts, event design and art education
                            has provided opportunities to collaborate with artists, journalists, writers and editors.
                            Throughout my artistic and educational career, I have published, presented and exhibited
                            work across these diverse fields, while continuing to pursue a multidisciplinary approach
                            that connects my various practices.
                            </p>
                    `}
            />

        </main>

    </div>

</BaseLayout>