---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PageContent from "../../components/PageContent.astro";
import ArtworkGallery from "../../components/ArtworkGallery.astro";
import graphicArtArtworks from "../../data/graphic-art.json";

const graphicArtFilters = [
    {
        key: "series",
        label: { fr: "Série", en: "Series" },
        options: [
            { value: "everyday-futility", label: { fr: "Futilité quotidienne", en: "Everyday Futility" } },
            { value: "night", label: { fr: "Nuit", en: "Night" } },
            { value: "aberrant-architecture", label: { fr: "Architecture aberrante", en: "Aberrant Architecture" } },
            { value: "enfantasque", label: { fr: "Enfantasque", en: "Childish" } },
            { value: "antiadvertise", label: { fr: "Antipublicité", en: "Antiadvertise" } },
        ],
    },
    {
        key: "technique",
        label: { fr: "Technique", en: "Technique" },
        options: [
            { value: "linocut", label: { fr: "Linogravure", en: "Linocut" } },
            { value: "mixed-media", label: { fr: "Technique mixte", en: "Mixed Media" } },
            { value: "drawing", label: { fr: "Dessin", en: "Drawing" } },
        ],
    },
    {
        key: "year",
        label: { fr: "Année", en: "Year" },
        options: [
            { value: "2008", label: { fr: "2008", en: "2008" } },
            { value: "2010", label: { fr: "2010", en: "2010" } },
            { value: "2011", label: { fr: "2011", en: "2011" } },
            { value: "2021", label: { fr: "2021", en: "2021" } },
            { value: "2024", label: { fr: "2024", en: "2024" } },
        ],
    },
    {
        key: "format",
        label: { fr: "Format", en: "Format" },
        options: [
            { value: "landscape", label: { fr: "Paysage", en: "Landscape" } },
        ],
    },
    {
        key: "palette",
        label: { fr: "Couleur", en: "Colour" },
        options: [
            { value: "colour", label: { fr: "Couleur", en: "Colour" } },
        ],
    },
];
---



<BaseLayout title="Graphic Art | Dan Zbarcea" lang="en-CA">

    <div class="page">

        <Sidebar lang="en" page="graphic-art" />

        <main class="content">

            <PageContent
                    title="Graphic Art"
                    text="This section presents graphic artworks exploring form, texture and composition through different visual approaches. The works move between abstraction, illustration and graphic experimentation."
            />

            <ArtworkGallery
                    lang="en"
                    artworks={graphicArtArtworks}
                    filters={graphicArtFilters}
            />

        </main>

    </div>

</BaseLayout>