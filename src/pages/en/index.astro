---
import artworks from "../../data/artworks.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PageContent from "../../components/PageContent.astro";
---

<BaseLayout
        title="Dan Zbarcea"
        description="Portfolio of visual artist Dan Zbarcea featuring photography, painting and graphic art."
        lang="en-CA"
>
    <div class="page">
        <Sidebar lang="en" page="home" />

        <main class="content">
            <PageContent>
                <figure class="home-quote">
                    <blockquote>
                        “Yesterday, we were missing freedom. Today we miss love.
                        I’m afraid of tomorrow for we will miss humanity.”
                    </blockquote>

                    <figcaption>Mahmoud Darwish</figcaption>
                </figure>
            </PageContent>
        </main>
    </div>
</BaseLayout>