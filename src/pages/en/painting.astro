---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PageContent from "../../components/PageContent.astro";
import ArtworkGallery from "../../components/ArtworkGallery.astro";
import paintingArtworks from "../../data/painting.json";

const paintingFilters = [
    {
        key: "series",
        label: { fr: "Série", en: "Series" },
        options: [
            { value: "precarious-line", label: { fr: "Ligne précaire", en: "Precarious Line" } },
            { value: "ecce-homo", label: { fr: "Ecce Homo", en: "Ecce Homo" } },
            { value: "psycho-object", label: { fr: "Psycho Objet", en: "Psycho Object" } },
            { value: "concrete-object", label: { fr: "Objet Concret", en: "Concrete Object" } },
            { value: "psycho-space", label: { fr: "Psycho Espace", en: "Psycho Space" } },
        ],
    },
    {
        key: "technique",
        label: { fr: "Technique", en: "Technique" },
        options: [
            { value: "peinture", label: { fr: "Peinture", en: "Painting" } },
        ],
    },
    {
        key: "year",
        label: { fr: "Année", en: "Year" },
        options: [
            { value: "1999", label: { fr: "1999", en: "1999" } },
            { value: "2020", label: { fr: "2020", en: "2020" } },
            { value: "2022", label: { fr: "2022", en: "2022" } },
            { value: "2023", label: { fr: "2023", en: "2023" } },
            { value: "2024", label: { fr: "2024", en: "2024" } },
            { value: "2025", label: { fr: "2025", en: "2025" } },
            { value: "2026", label: { fr: "2026", en: "2026" } },
        ],
    },
    {
        key: "format",
        label: { fr: "Format", en: "Format" },
        options: [
            { value: "landscape", label: { fr: "Paysage", en: "Landscape" } },
        ],
    },
    {
        key: "palette",
        label: { fr: "Couleur", en: "Colour" },
        options: [
            { value: "colour", label: { fr: "Couleur", en: "Colour" } },
        ],
    },
];
---

<BaseLayout
        title="Painting | Dan Zbarcea"
        description="A selection of paintings by Dan Zbarcea, exploring line, memory and emotion through acrylic and mixed media."
        lang="en-CA"
>

    <div class="page">

        <Sidebar lang="en" page="painting" />

        <main class="content">

            <PageContent
                    title="Painting"
                    text="This section presents a selection of paintings exploring line, presence, memory and emotion through acrylic and mixed media works."
            />

            <ArtworkGallery
                    lang="en"
                    artworks={paintingArtworks}
                    filters={paintingFilters}
            />

        </main>

    </div>

</BaseLayout>