---
import artworks from "../../data/artworks.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PageContent from "../../components/PageContent.astro";
---

<BaseLayout title="Dan Zbarcea" lang="fr-CA">
    <div class="page">
        <Sidebar lang="fr" page="home" />

        <main class="content">
            <PageContent>
            <figure class="home-quote">
                <blockquote>
                    « Hier, nous manquions de liberté. Aujourd’hui, nous manquons d’amour. J’ai peur de demain, car nous manquerons d’humanité. »
                </blockquote>

                <figcaption>Mahmoud Darwish</figcaption>
            </figure>
            </PageContent>
        </main>
    </div>
</BaseLayout>